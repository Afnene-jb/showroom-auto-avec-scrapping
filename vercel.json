{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": "src",
      "framework": "angular"
    },
    "scraper": {
      "root": "scraper",
      "runtime": "node"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "scraper" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "app" }
    }
  ]
}